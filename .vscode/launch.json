{
    // Используйте IntelliSense, чтобы узнать о возможных атрибутах.
    // Наведите указатель мыши, чтобы просмотреть описания существующих атрибутов.
    // Для получения дополнительной информации посетите: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Отладка FreeBASIC File",
            "type": "freebasic-gdb",
            "request": "launch",
            "sourceFile": "${file}",
            "cwd": "${fileDirname}",
            "arch": "auto",
            "compilerArgs": [
                "-target", "win64", // Платформа
                "-s", "console", // Подсистема
                "-g", // Флаг для генерации отладочной информации
                "-gen", "gcc", // Генерировать стандартный C код для GCC бекенда "gas64" или "gcc"
                //"-R", // Разрешить компилятору оставлять .c, .asm листинги и оставить
                //"-v", // Подробная информация о компиляции и линковке
            ],
            "args": [],
            "stopAtEntry": true
        }
    ]
}