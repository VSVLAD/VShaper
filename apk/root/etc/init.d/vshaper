#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1
BIN="/usr/bin/vshaper"

add_client_rule() {
    local cfg="$1"
    local ip down up

    config_get ip "$cfg" ip
    config_get down "$cfg" down_limit
    config_get up "$cfg" up_limit

    if [ -n "$ip" ] && [ -n "$down" ] && [ -n "$up" ]; then
        $BIN add "$ip" "$down" "$up" "$LAN_IF" "$WAN_IF"
    fi
}

start_service() {
    local enabled lan_if wan_if

    config_load vshaper
    config_get_bool enabled settings enabled 0
    config_get lan_if settings lan_if
    config_get wan_if settings wan_if

    [ "$enabled" -eq 1 ] || return 0
    [ -n "$lan_if" ] && [ -n "$wan_if" ] || return 0

    LAN_IF="$lan_if"
    WAN_IF="$wan_if"

    $BIN start "$lan_if" "$wan_if"
    config_foreach add_client_rule client
}

stop_service() {
    local lan_if wan_if
    config_load vshaper
    config_get lan_if settings lan_if
    config_get wan_if settings wan_if

    if [ -n "$lan_if" ] && [ -n "$wan_if" ]; then
        $BIN stop "$lan_if" "$wan_if"
    fi
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "vshaper"
}